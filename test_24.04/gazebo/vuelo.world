<?xml version="1.0" ?>
<!--
  vuelo.world - Convertido para Gazebo Harmonic (gz-sim 8.x) + ROS 2 Jazzy
  
  CAMBIOS RESPECTO A GAZEBO CLASSIC:
  1. sdf version 1.6 → 1.9
  2. Plugin gazebo_ros_state (libgazebo_ros_state.so) ELIMINADO
     → El estado del modelo se maneja via ros_gz_bridge en el launch file
  3. Plugin wave_visual (libgazebo_ros_wave_visual.so) ELIMINADO
     → No existe en Harmonic; material de agua simplificado con OGRE2
  4. Material Gazebo/Water → material PBR nativo de Harmonic
  5. Plugin libKeyboardGUIPlugin.so ELIMINADO → no existe en Harmonic GUI
  6. <grid> en <gui> ELIMINADO → Harmonic tiene grid por defecto en la GUI
  7. <include><uri>model://sun</uri> → reemplazado por luz direccional nativa
  8. La posición del ekranoplano y rosa_referencia se mantienen igual
  
  PARA MOVER EL EKRANOPLANO DESDE SIMULINK/ROS2:
  Usar ros_gz_bridge con el topic:
    /world/default/set_pose  (gz.msgs.Pose)
  o via servicio:
    /world/default/set_pose  (gz.msgs.Pose)
  Ver launch file para configuración del bridge.
-->
<sdf version="1.9">
  <world name="vuelo">

    <!-- Gravedad desactivada: Simulink calcula la dinámica completa -->
    <gravity>0 0 0</gravity>

    <!-- Física: paso de integración rápido para sincronizar con Simulink a 100Hz -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <!-- Plugin de ROS 2 para Gazebo Harmonic -->
    <!-- Reemplaza libgazebo_ros_state.so de Classic -->
    <!-- El bridge se configura en el launch file de ROS 2 -->

    <!-- Iluminación: reemplaza model://sun de Classic -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1.0</diffuse>
      <specular>0.5 0.5 0.5 1.0</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Océano: plano estático con material PBR azul -->
    <!-- libgazebo_ros_wave_visual.so no existe en Harmonic -->
    <!-- Las olas se simulan matematicamente en Simulink via topics ROS 2 -->
    <model name="ocean">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ocean_link">
        <visual name="ocean_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20000 20000</size>
            </plane>
          </geometry>
          <material>
            <!-- Material PBR nativo Harmonic/OGRE2 - reemplaza Gazebo/Water -->
            <ambient>0.0 0.35 0.60 0.85</ambient>
            <diffuse>0.0 0.50 0.80 0.85</diffuse>
            <specular>0.4 0.4 0.4 1.0</specular>
            <pbr>
              <metal>
                <metalness>0.05</metalness>
                <roughness>0.3</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <!-- Colisión del océano para referencia de altura -->
        <collision name="ocean_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20000 20000</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Modelo del ekranoplano -->
    <!-- Cargado desde la carpeta models/ local -->
    <!-- Su posición se actualiza desde Simulink via ros_gz_bridge -->
    <include>
      <name>ekranoplano</name>
      <uri>model://mi_ekranoplano</uri>
      <!-- Posición inicial: z=1m sobre el océano, match con z_NED inicial de Simulink -->
      <pose>0 0 1 0 0 0</pose>
    </include>

    <!-- Rosa de referencia de ejes XY -->
    <include>
      <name>ejes_radiales</name>
      <uri>model://rosa_referencia</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Configuración GUI de Gazebo Harmonic -->
    <!-- libKeyboardGUIPlugin.so no existe en Harmonic -->
    <!-- El grid es nativo en la GUI de Harmonic, no necesita declaración -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.5 0.7 1.0</background_color>
        <camera_pose>5 -5 2 0 0.2 2.3</camera_pose>
        <camera_clip>
          <near>0.1</near>
          <far>50000</far>
        </camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
    </gui>

  </world>
</sdf>
